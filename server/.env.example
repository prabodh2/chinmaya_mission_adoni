PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/anti_drug_marathon_2026
JWT_SECRET=your_production_jwt_secret_key_change_me
JWT_EXPIRES_IN=365d

# ─── Cloudflare R2 (S3-compatible Object Storage) ────────────────────────────
# Create an API token in Cloudflare Dashboard → R2 → Manage API tokens
# Token permissions: Object Read & Write on your bucket
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=chinmaya-assets
# Public URL: either a custom domain connected to your R2 bucket,
# or the auto-generated R2 dev URL: https://pub-<ACCOUNT_ID>.r2.dev
R2_PUBLIC_URL=https://assets.chinmayamissionadoni.org

# ─── Google Sheets Integration ────────────────────────────────────────────────
GOOGLE_SHEETS_ID=your_google_sheet_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account_email@iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key\n-----END PRIVATE KEY-----\n"

CLIENT_URL=http://localhost:5176
